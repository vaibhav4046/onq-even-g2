# Names only. Copy to .env and fill in locally; never commit real values.
# The encrypted vault (Connect screen) is primary; these are fallbacks when the vault has no value.

# Notion (fallback when no Notion token is saved in the vault)
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Model providers
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# Voice
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_REGION=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
